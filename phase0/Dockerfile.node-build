FROM oven/bun:1.3.12 AS dependencies
WORKDIR /workspace
ENV DATABASE_URL=postgresql://phase0:phase0@127.0.0.1:1/phase0
COPY . .
RUN bun install --frozen-lockfile

FROM node:24.18.0-bookworm AS build
WORKDIR /workspace
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL=postgresql://phase0:phase0@127.0.0.1:1/phase0
ENV APP_URL=http://localhost:3000
ENV API_URL=http://localhost:3001
COPY --from=dependencies /workspace /workspace
RUN BETTER_AUTH_SECRET=phase0-build-only-secret-not-production node apps/app/node_modules/next/dist/bin/next build apps/app

FROM node:24.18.0-bookworm-slim AS runtime
WORKDIR /workspace
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /workspace /workspace
EXPOSE 3000
CMD ["node", "apps/app/node_modules/next/dist/bin/next", "start", "apps/app"]
