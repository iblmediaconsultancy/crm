  outreachContacts       Int      @default(0)
  followUps              Int      @default(0)
  qualifiedOpportunities Int      @default(0)
  proposals              Int      @default(0)
  clientsClosed          Int      @default(0)
  mrrGeneratedTargetBase Decimal? @db.Decimal(24, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@map("weeklyTarget")
}

model WorkspacePermissionOverride {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("PermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  permission      String
  allowed         Boolean
  createdByUserId String
  createdBy       User     @relation("PermissionOverrideCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, permission])
  @@index([permission, allowed])
  @@map("workspacePermissionOverride")
}

model DomainAuditEvent {
  id          String           @id @default(cuid())
  actorUserId String?
  actor       User?            @relation("DomainAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  DomainEntityType
  entityId    String?
  outcome     String
  requestId   String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@unique([action, requestId])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("domainAuditEvent")
}

enum DurableJobStatus {
  PENDING
  LEASED
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum DncStatus {
  ALLOWED
  DO_NOT_CONTACT
}

enum FollowUpPlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum FollowUpStepStatus {
  PENDING
  LEASED
  QUEUED
  COMPLETED
  CANCELLED
  DEAD
}

enum AttachmentStatus {
  QUARANTINED
  CLEAN
  INFECTED
  REJECTED
  SCAN_FAILED
}

enum AllocationRequestStatus {
  PENDING
  LEASED
  ALLOCATED
  UNALLOCATED
  FAILED
  DEAD
}

model SystemEmailJob {
  id                String           @id @default(cuid())
  kind              String
  actorUserId       String
  recipientEmail    String
  subject           String
  textBody          String
  status            DurableJobStatus @default(PENDING)
  idempotencyKey    String           @unique
  providerMessageId String?
  attemptCount      Int              @default(0)
  maxAttempts       Int              @default(5)
  leaseOwner        String?
  leasedUntil       DateTime?
  retryAt           DateTime?
  lastErrorCode     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, retryAt, leasedUntil])
  @@map("systemEmailJob")
}

model ContactRouteConsent {
  id              String    @id @default(cuid())
  routeId         String    @unique
  contactId       String
  status          DncStatus @default(ALLOWED)
  reason          String?
  source          String
  changedByUserId String?
  changedAt       DateTime  @default(now())
  consentedAt     DateTime?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([contactId, status])
  @@map("contactRouteConsent")
}

model FollowUpPlan {
  id                 String             @id @default(cuid())
  contactId          String
  routeId            String
  ownerUserId        String
  sourceDraftId      String?
  leadId             String?
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  maxSteps           Int                @default(3)
  status             FollowUpPlanStatus @default(ACTIVE)
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([contactId, status])
  @@index([ownerUserId, status])
  @@index([leadId, status])
  @@map("followUpPlan")
}

model FollowUpStep {
  id             String             @id @default(cuid())
  planId         String
  position       Int
  dueAt          DateTime
  status         FollowUpStepStatus @default(PENDING)
  draftId        String?
  idempotencyKey String             @unique
  attemptCount   Int                @default(0)
  maxAttempts    Int                @default(5)
  leaseOwner     String?
  leasedUntil    DateTime?
  retryAt        DateTime?
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([planId, position])
  @@index([status, dueAt, retryAt, leasedUntil])
  @@map("followUpStep")
}

model OutreachEvent {
  id                String   @id @default(cuid())
  deliveryId        String
  eventType         String
  providerEventId   String   @unique
  providerMessageId String?
  occurredAt        DateTime
  payloadDigest     String
  createdAt         DateTime @default(now())

  @@index([deliveryId, occurredAt])
  @@map("outreachEvent")
}

model OutreachQuota {
  id                String   @id @default(cuid())
  day               DateTime @db.Date
  coldEmailLimit    Int
  coldEmailReserved Int      @default(0)
  coldEmailSent     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([day])
  @@map("outreachQuota")
}

model AllocationPolicy {
  id              String    @id @default(cuid())
  version         Int       @unique
  name            String
  active          Boolean   @default(false)
  rules           Json
  createdByUserId String
  createdAt       DateTime  @default(now())
  activatedAt     DateTime?

  @@index([active, version])
  @@map("allocationPolicy")
}

model AllocationRequest {
  id                String                  @id @default(cuid())
  entityType        DomainEntityType
  entityId          String
  policyVersion     Int?
  status            AllocationRequestStatus @default(PENDING)
  requestedByUserId String?
  idempotencyKey    String                  @unique
  explanation       Json?
  assigneeUserId    String?
  attemptCount      Int                     @default(0)
  maxAttempts       Int                     @default(5)
  leaseOwner        String?
  leasedUntil       DateTime?
  retryAt           DateTime?
  lastErrorCode     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, retryAt, leasedUntil])
  @@index([entityType, entityId, status])
  @@map("allocationRequest")
}

model MessageAttachment {
  id              String           @id @default(cuid())
  mailboxId       String
  messageId       String
  filename        String
  mediaType       String
  contentId       String?
  disposition     String?
  byteSize        Int
  checksumSha256  String
  objectKey       String           @unique
  status          AttachmentStatus @default(QUARANTINED)
  scanCompletedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([mailboxId, messageId])
  @@index([status, createdAt])
  @@map("messageAttachment")
}

model AttachmentScanJob {
  id             String           @id @default(cuid())
  attachmentId   String           @unique
  status         DurableJobStatus @default(PENDING)
  idempotencyKey String           @unique
  attemptCount   Int              @default(0)
  maxAttempts    Int              @default(5)
  leaseOwner     String?
  leasedUntil    DateTime?
  retryAt        DateTime?
  lastErrorCode  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, retryAt, leasedUntil])
  @@map("attachmentScanJob")
}

model MimeIngestionError {
  id              String           @id @default(cuid())
  mailboxId       String
  providerUid     String
  rfcMessageId    String?
  errorCode       String
  detail          String?
  reprocessStatus DurableJobStatus @default(FAILED)
  attemptCount    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([mailboxId, providerUid])
  @@index([reprocessStatus, updatedAt])
  @@map("mimeIngestionError")
}

model ProviderEvidence {
  id                  String                @id @default(cuid())
  capability          ProviderCapabilityKey
  probeKind           String
  outcome             String
  evidence            Json
  configurationDigest String
  operatorUserId      String
  createdAt           DateTime              @default(now())

  @@index([capability, createdAt])
  @@map("providerEvidence")
}
