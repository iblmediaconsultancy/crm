datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  previewFeatures        = ["partialIndexes"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  kind          UserKind  @default(HUMAN)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  ownedCompanies       Company[]            @relation("CompanyOwner")
  ownedContacts        Contact[]            @relation("ContactOwner")
  ownedDeals           Deal[]               @relation("DealOwner")
  activities           Activity[]           @relation("ActivityAuthor")
  mailboxSyncs         MailboxSync[]
  profile              UserProfile?
  ownedMailboxes       Mailbox[]            @relation("MailboxOwner")
  mailboxGrants        MailboxGrant[]       @relation("MailboxGrantee")
  grantedMailboxAccess MailboxGrant[]       @relation("MailboxGrantor")
  securityAuditEvents  SecurityAuditEvent[] @relation("SecurityAuditActor")
  factDecisions        ContactFact[]        @relation("FactDecider")
  conversations        AgentConversation[]  @relation("ConversationOwner")
  fieldValues          FieldValue[]         @relation("FieldValueUser")

  createdAgentDefinitions AgentDefinition[]             @relation("AgentDefinitionCreator")
  createdAgentVersions    AgentVersion[]                @relation("AgentVersionCreator")
  createdAgentTriggers    AgentTrigger[]                @relation("AgentTriggerCreator")
  initiatedAgentRuns      AgentRun[]                    @relation("AgentRunInitiator")
  agentAuditEvents        AgentAuditEvent[]             @relation("AgentAuditActor")
  conversationShares      AgentConversationShare[]      @relation("ConversationShareCreator")
  conversationSubmissions AgentConversationSubmission[] @relation("ConversationSubmissionAuthor")
  conversationFeedback    AgentConversationFeedback[]   @relation("ConversationFeedbackAuthor")

  ownedContactRoutes         ContactRoute[]                @relation("ContactRouteOwner")
  approvedRoutePolicies      SharedRoutePolicy[]           @relation("SharedRoutePolicyApprover")
  createdRepresentations     Representation[]              @relation("RepresentationCreator")
  representationChanges      RepresentationHistory[]       @relation("RepresentationHistoryActor")
  ownedLeads                 Lead[]                        @relation("LeadOwner")
  createdLeads               Lead[]                        @relation("LeadCreator")
  leadStageChanges           LeadStageHistory[]            @relation("LeadStageHistoryActor")
  assignedOperationalTasks   OperationalTask[]             @relation("OperationalTaskAssignee")
  createdOperationalTasks    OperationalTask[]             @relation("OperationalTaskCreator")
  authoredNotes              Note[]                        @relation("NoteAuthor")
  ownedTemplates             Template[]                    @relation("TemplateOwner")
  ownedDrafts                Draft[]                       @relation("DraftOwner")
  ownedProposals             Proposal[]                    @relation("ProposalOwner")
  requestedApprovals         OutreachApproval[]            @relation("OutreachApprovalRequester")
  decidedApprovals           OutreachApproval[]            @relation("OutreachApprovalApprover")
  receivedAssignments        Assignment[]                  @relation("AssignmentAssignee")
  createdAssignments         Assignment[]                  @relation("AssignmentCreator")
  lifecycleEvents            LifecycleEvent[]              @relation("LifecycleEventActor")
  evidenceSources            EvidenceSource[]              @relation("EvidenceSourceCreator")
  duplicateReviews           DuplicateCandidate[]          @relation("DuplicateCandidateReviewer")
  mergeDecisions             MergeDecision[]               @relation("MergeDecisionDecider")
  researchRequests           ResearchRequest[]             @relation("ResearchRequestOwner")
  domainAuditEvents          DomainAuditEvent[]            @relation("DomainAuditActor")
  financialEvents            FinancialEvent[]              @relation("FinancialEventActor")
  commissionRecipients       ClientCommission[]            @relation("CommissionRecipient")
  createdExpenses            CompanyExpense[]              @relation("ExpenseCreator")
  createdGoals               CompanyGoal[]                 @relation("GoalCreator")
  weeklyTargets              WeeklyTarget[]                @relation("WeeklyTargetUser")
  permissionOverrides        WorkspacePermissionOverride[] @relation("PermissionOverrideUser")
  createdPermissionOverrides WorkspacePermissionOverride[] @relation("PermissionOverrideCreator")

  members     Member[]
  invitations Invitation[]

  ssoproviders SsoProvider[]

  @@unique([email])
  @@map("user")
}

enum UserKind {
  HUMAN
  SYSTEM_OPERATOR
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum DealStage {
  DEMO_BOOKED
  QUALIFIED_TO_BUY
  UNQUALIFIED_TO_BUY
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum BillingStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  ENDED
}

enum PaymentStatus {
  NOT_APPLICABLE
  CURRENT
  PENDING
  OVERDUE
  PAID
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum FinancialEventType {
  PROFILE_CREATED
  PROFILE_UPDATED
  FEE_CHANGED
  STATUS_CHANGED
  PAYMENT_STATUS_CHANGED
  CHURNED
  SNAPSHOT_RECORDED
}

enum CompanyGoalType {
  MRR
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  REFERRAL
}

enum AgentConversationKind {
  RECORD
  BUILDER
}

enum AgentDefinitionStatus {
  DRAFT
  DEPLOYING
  LIVE
  PAUSED
  ARCHIVED
  DELETED
}

enum AgentVersionStatus {
  DRAFT
  VALIDATING
  READY
  DEPLOYED
  REJECTED
}

enum AgentBuilderArtifactStatus {
  WRITING
  READY
}

enum AgentTriggerType {
  MANUAL
  SCHEDULE
  EVENT
  WEBHOOK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentActionStatus {
  PLANNED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentConversationShareScope {
  WORKSPACE_LINK
}

enum AgentConversationSubmissionStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  CANCELLED
}

enum AgentConversationCommandType {
  CHAT
  CREATE_AGENT
}

enum AgentResponseRating {
  UP
  DOWN
}

enum CanonicalLifecycleState {
  ACTIVE
  ARCHIVED
}

model Company {
  id          String  @id @default(cuid())
  name        String
  domain      String?
  website     String?
  description String?

  logoUrl     String?
  logoDarkUrl String?
  iconUrl     String?
  iconDarkUrl String?
  iconTone    String?
  brandColor  String?

  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  source RecordSource @default(MANUAL)

  lifecycleState   CanonicalLifecycleState @default(ACTIVE)
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  version          Int                     @default(1)

  lastActivityAt DateTime?

  contacts            Contact[]                @relation("CompanyContacts")
  conversations       AgentConversation[]
  deals               Deal[]
  activities          Activity[]
  emailThreads        EmailThread[]
  calendarEvents      CalendarEvent[]
  fieldValues         FieldValue[]
  agencyProfile       Agency?
  clubProfile         Club?
  contactRoutes       ContactRoute[]
  sharedRoutePolicies SharedRoutePolicy[]
  representations     Representation[]
  leads               Lead[]
  operationalTasks    OperationalTask[]
  notes               Note[]
  proofItems          ProofItem[]
  financialProfiles   ClientFinancialProfile[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([domain])
  @@index([lastActivityAt])
  @@index([lifecycleState, name])
  @@map("company")
}

model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  outreachState          ContactOutreachState @default(ALLOWED)
  outreachStateReason    String?
  outreachStateChangedAt DateTime?

  lifecycleState   CanonicalLifecycleState @default(ACTIVE)
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  version          Int                     @default(1)

  lastActivityAt DateTime?

  deals                 DealContact[]
  activities            Activity[]
  emailThreads          EmailThread[]
  calendarEvents        CalendarEvent[]
  eventAttendance       CalendarAttendee[]
  fieldValues           FieldValue[]
  playerProfile         FootballPlayer?
  footballAgentProfile  FootballAgent?
  contactRoutes         ContactRoute[]
  sharedRoutePolicies   SharedRoutePolicy[]
  playerRepresentations Representation[]         @relation("RepresentationPlayer")
  agentRepresentations  Representation[]         @relation("RepresentationAgent")
  leads                 Lead[]
  operationalTasks      OperationalTask[]
  notes                 Note[]
  proofItems            ProofItem[]
  financialProfiles     ClientFinancialProfile[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([email])
  @@index([outreachState])
  @@index([lastActivityAt])
  @@index([lifecycleState, firstName])
  @@map("contact")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

model AgentTask {
  id        String  @id @default(cuid())
  contactId String?
  companyId String?

  kind   String
  reason String

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@map("agentTask")
}

model AgentEvent {
  id        String  @id
  sessionId String
  contactId String?
  type      String
  data      Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@map("agentEvent")
}

model AgentConversation {
  id String @id @default(cuid())

  kind AgentConversationKind @default(RECORD)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  agentId String?
  agent   AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  sessionId         String? @unique
  continuationToken String?
  streamIndex       Int     @default(0)

  title        String?
  messageCount Int     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastMessageAt   DateTime  @default(now())
  lastAssistantAt DateTime?
  lastReadAt      DateTime?

  shares           AgentConversationShare[]
  submissions      AgentConversationSubmission[]
  feedback         AgentConversationFeedback[]
  createdVersions  AgentVersion[]                @relation("AgentVersionSourceConversation")
  builderArtifacts AgentBuilderArtifact[]

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([userId, kind, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@map("agentConversation")
}

model AgentConversationFeedback {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)

  messageId String
  rating    AgentResponseRating

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId, messageId])
  @@index([conversationId, createdAt])
  @@map("agentConversationFeedback")
}

model AgentConversationShare {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ConversationShareCreator", fields: [createdById], references: [id], onDelete: Cascade)

  scope     AgentConversationShareScope @default(WORKSPACE_LINK)
  tokenHash String                      @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@unique([conversationId], map: "agentConversationShare_one_active_per_conversation", where: { revokedAt: null })
  @@index([conversationId, revokedAt])
  @@map("agentConversationShare")
}

model AgentConversationSubmission {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  submittedById String
  submittedBy   User   @relation("ConversationSubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)

  clientRequestId String                            @unique
  inputRequestId  String?
  commandType     AgentConversationCommandType      @default(CHAT)
  message         Json
  status          AgentConversationSubmissionStatus @default(PENDING)
  attemptCount    Int                               @default(0)

  errorCode    String?
  errorMessage String?

  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?

  attachments AgentConversationAttachment[]

  @@unique([conversationId, inputRequestId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@map("agentConversationSubmission")
}

model AgentConversationAttachment {
  id String @id @default(cuid())

  submissionId String
  submission   AgentConversationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name      String
  mediaType String
  size      Int
  content   Bytes
  position  Int

  createdAt DateTime @default(now())

  @@index([submissionId, position])
  @@map("agentConversationAttachment")
}

model AgentDefinition {
  id String @id @default(cuid())

  name        String
  description String?
  status      AgentDefinitionStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("AgentDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  currentVersionId String?       @unique
  currentVersion   AgentVersion? @relation("CurrentAgentVersion", fields: [currentVersionId, id], references: [id, agentId], onDelete: Restrict)

  versions      AgentVersion[]      @relation("AgentVersions")
  triggers      AgentTrigger[]
  runs          AgentRun[]
  actions       AgentAction[]
  auditEvents   AgentAuditEvent[]
  conversations AgentConversation[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  @@unique([currentVersionId, id])
  @@index([status, updatedAt])
  @@index([createdById, createdAt])
  @@map("agentDefinition")
}

model AgentVersion {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Restrict)

  number Int
  status AgentVersionStatus @default(DRAFT)

  instructions             String
  manifest                 Json
  modelId                  String
  modelContextWindowTokens Int    @default(1000000)
  sandboxPolicy            Json
  validation               Json?

  sourceConversationId String?
  sourceConversation   AgentConversation? @relation("AgentVersionSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("AgentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  deploymentId String?
  approvedAt   DateTime?
  deployedAt   DateTime?
  createdAt    DateTime  @default(now())

  currentFor       AgentDefinition?       @relation("CurrentAgentVersion")
  triggers         AgentTrigger[]
  runs             AgentRun[]
  auditEvents      AgentAuditEvent[]
  builderArtifacts AgentBuilderArtifact[]

  @@unique([agentId, number])
  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@map("agentVersion")
}

model AgentBuilderArtifact {
  id String @id @default(cuid())

  conversationId String?
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  path            String
  language        String
  content         String
  previousContent String?
  revision        Int
  status          AgentBuilderArtifactStatus @default(WRITING)
  createdAt       DateTime                   @default(now())

  @@unique([conversationId, path, revision], map: "agentBuilderArtifact_conversation_path_revision_key", where: { conversationId: { not: null } })
  @@unique([versionId, path, revision], map: "agentBuilderArtifact_version_path_revision_key", where: { versionId: { not: null } })
  @@index([conversationId, createdAt])
  @@index([versionId, path])
  @@map("agentBuilderArtifact")
}

model AgentTrigger {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  type   AgentTriggerType
  name   String
  config Json

  createdById String
  createdBy   User   @relation("AgentTriggerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  enabled   Boolean   @default(false)
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  runs AgentRun[]

  @@unique([id, agentId])
  @@index([agentId, enabled])
  @@index([enabled, nextRunAt])
  @@index([versionId])
  @@map("agentTrigger")
}

model AgentRun {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String
  version   AgentVersion @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  triggerId String?
  trigger   AgentTrigger? @relation(fields: [triggerId, agentId], references: [id, agentId], onDelete: Restrict)

  initiatedById String?
  initiatedBy   User?   @relation("AgentRunInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  triggerType    AgentTriggerType
  status         AgentRunStatus   @default(QUEUED)
  principalId    String?
  sessionId      String?          @unique
  idempotencyKey String           @unique
  correlationId  String           @unique

  input   Json?
  result  Json?
  summary String?

  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  errorCode    String?
  errorMessage String?

  nextEventSequence Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  events  AgentRunEvent[]
  actions AgentAction[]

  @@unique([id, agentId])
  @@index([agentId, createdAt])
  @@index([versionId, createdAt])
  @@index([status, createdAt])
  @@index([triggerId, createdAt])
  @@map("agentRun")
}

model AgentRunEvent {
  id String @id @default(cuid())

  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  sequence  Int
  type      String
  data      Json
  emittedAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, emittedAt])
  @@map("agentRunEvent")
}

model AgentAction {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  runId String
  run   AgentRun @relation(fields: [runId, agentId], references: [id, agentId], onDelete: Restrict)

  type        String
  provider    String
  targetType  String?
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json?

  status         AgentActionStatus @default(PLANNED)
  idempotencyKey String            @unique
  requestHash    String?
  externalId     String?
  attemptCount   Int               @default(0)

  errorCode    String?
  errorMessage String?

  plannedAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([agentId, plannedAt])
  @@index([runId, plannedAt])
  @@index([provider, externalId])
  @@index([status, plannedAt])
  @@map("agentAction")
}

model AgentAuditEvent {
  id String @id @default(cuid())

  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Restrict)

  versionId String?
  version   AgentVersion? @relation(fields: [versionId, agentId], references: [id, agentId], onDelete: Restrict)

  actorUserId String?
  actorUser   User?   @relation("AgentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  type      String
  actorType String
  actorId   String?
  summary   String
  before    Json?
  after     Json?
  requestId String?
  emittedAt DateTime @default(now())

  @@unique([agentId, type, requestId])
  @@index([agentId, emittedAt])
  @@index([versionId, emittedAt])
  @@index([actorUserId, emittedAt])
  @@index([type, emittedAt])
  @@map("agentAuditEvent")
}

model Deal {
  id              String              @id @default(cuid())
  conversations   AgentConversation[]
  name            String
  description     String?
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User                @relation("DealOwner", fields: [ownerId], references: [id])
  pipelineStageId String?
  pipelineStage   PipelineStage?      @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  stage             DealStage @default(DEMO_BOOKED)
  stageChangedAt    DateTime  @default(now())
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?

  baseAmount                  Decimal?  @db.Decimal(24, 4)
  baseCurrency                String?
  fxRate                      Decimal?  @db.Decimal(20, 10)
  fxRateAt                    DateTime?
  potentialMonthlyRevenue     Decimal?  @db.Decimal(14, 2)
  potentialMonthlyRevenueBase Decimal?  @db.Decimal(24, 4)
  potentialOneOffRevenue      Decimal?  @db.Decimal(14, 2)
  potentialOneOffRevenueBase  Decimal?  @db.Decimal(24, 4)
  potentialPackageName        String?
  potentialBaseCurrency       String?
  potentialFxRate             Decimal?  @db.Decimal(20, 10)
  potentialFxRateAt           DateTime?

  lifecycleState   CanonicalLifecycleState @default(ACTIVE)
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?
  version          Int                     @default(1)

  lastActivityAt DateTime?

  contacts         DealContact[]
  activities       Activity[]
  fieldValues      FieldValue[]
  operationalTasks OperationalTask[]
  notes            Note[]
  proofItems       ProofItem[]
  leads            Lead[]
  proposals        Proposal[]
  financialProfile ClientFinancialProfile?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([pipelineStageId])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@index([baseAmount])
  @@index([potentialMonthlyRevenueBase])
  @@index([currency])
  @@index([lifecycleState, name])
  @@map("deal")
}

