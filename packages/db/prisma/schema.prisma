  @@unique([fieldId, companyId])
  @@unique([fieldId, contactId])
  @@unique([fieldId, dealId])
  @@index([fieldId, text])
  @@index([fieldId, number])
  @@index([fieldId, date])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([optionId])
  @@index([userId])
