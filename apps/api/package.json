{
	"name": "api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"exports": {
		"./app-router": "./src/generated/server.ts"
	},
	"scripts": {
		"build": "bun build src/main.ts --target=bun --outdir dist --external @nestjs/graphql --external @nestjs/microservices --external @nestjs/microservices/* --external @nestjs/websockets/*",
		"check-types": "tsc --noEmit",
		"dev": "concurrently -n api,trpc -c blue,magenta \"bun --watch src/main.ts\" \"nestjs-trpc watch -e src/app.module.ts -r \u0027**/*.router.ts\u0027 -o src/generated\"",
		"dev:session": "bun scripts/dev-session.ts",
		"lint": "biome check .",
		"postinstall": "node scripts/chmod-trpc-binary.mjs",
		"start": "bun src/main.ts",
		"start:prod": "bun dist/main.js",
		"test": "CRM_TELEMETRY_DISABLED=1 bun test --preload ./test/setup.ts",
		"test:watch": "CRM_TELEMETRY_DISABLED=1 bun test --watch --preload ./test/setup.ts",
		"trpc:generate": "nestjs-trpc generate -e src/app.module.ts -r \"**/*.router.ts\" -o src/generated",
		"clean": "rm -rf .turbo dist node_modules src/generated",
		"providers:verify": "bun scripts/verify-providers.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.883.0",
		"@crm/auth": "workspace:*",
		"@crm/db": "workspace:*",
		"@crm/env": "workspace:*",
		"@crm/telemetry": "workspace:*",
		"@nestjs/cache-manager": "^3.1.3",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@thallesp/nestjs-better-auth": "^2.7.0",
		"@trpc/server": "^11.18.0",
		"@vercel/blob": "^2.6.1",
		"better-auth": "^1.6.25",
		"cache-manager": "^7.2.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"context.dev": "^2.7.0",
		"helmet": "^8.3.0",
		"imapflow": "^1.6.6",
		"nestjs-trpc": "^2.13.0",
		"postal-mime": "^2.7.6",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"svix": "1.84.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@nestjs/testing": "^11.0.1",
		"@types/bun": "^1.3.14",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.0.0",
		"concurrently": "^9.1.0",
		"supertest": "^7.0.0",
		"typescript": "^5.9.2"
	}
}
