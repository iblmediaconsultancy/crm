{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "trpc:generate"]
		},
		"trpc:generate": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["src/generated/**"]
		},
		"dev": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AUTH_COOKIE_DOMAIN",
				"AUTH_TRUSTED_ORIGINS",
				"BLOB_READ_WRITE_TOKEN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CACHE_TTL_MS",
				"DATABASE_URL",
				"GOOGLE_CALENDAR_CLIENT_ID",
				"GOOGLE_CALENDAR_CLIENT_SECRET",
				"GOOGLE_CALENDAR_CLIENT_SECRET_FILE",
				"GOOGLE_CALENDAR_PRIMARY_ID",
				"GOOGLE_CALENDAR_HVA_ID",
				"GOOGLE_CALENDAR_BLOCKER_IDS",
				"PORT",
				"ATLAS_LIVE_OUTREACH_ENABLED",
				"ATLAS_LINKEDIN_LOCAL_EXECUTOR_ENABLED",
				"RESEND_OUTREACH_FROM_EMAIL",
				"RESEND_OUTREACH_FROM_NAME"
			]
		},
		"test": {
			"passThroughEnv": [
				"AUTH_COOKIE_DOMAIN",
				"AUTH_TRUSTED_ORIGINS",
				"BLOB_READ_WRITE_TOKEN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CACHE_TTL_MS",
				"DATABASE_URL",
				"PORT",
				"ATLAS_LIVE_OUTREACH_ENABLED",
				"ATLAS_LINKEDIN_LOCAL_EXECUTOR_ENABLED",
				"RESEND_OUTREACH_FROM_EMAIL",
				"RESEND_OUTREACH_FROM_NAME"
			]
		}
	}
}
